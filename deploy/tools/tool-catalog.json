 {
  "id": "jadx",
  "name": "jadx",
  "kind": "script",
  "Detect": "dir:/opt/jadx",
  "Script": "set -e\n# jadx needs its lib/ dir next to the launcher -> install whole release to /opt/jadx.\n# Use GitHub API (token injected by installer) to get tag robustly.\nTAG=$(curl -fsSL --retry 5 --retry-delay 3 --connect-timeout 15 --max-time 120 https://api.github.com/repos/skylot/jadx/releases/latest | python3 -c 'import sys,json;print(json.load(sys.stdin)[\"tag_name\"])')\nVER=${TAG#v}\ncurl -fsSL --retry 5 --retry-delay 3 --connect-timeout 15 --max-time 600 -o /tmp/jadx.zip \"https://github.com/skylot/jadx/releases/download/${TAG}/jadx-${VER}.zip\"\nrm -rf /opt/jadx && mkdir -p /opt/jadx\nunzip -q -o /tmp/jadx.zip -d /opt/jadx\nln -sf /opt/jadx/bin/jadx /usr/local/bin/jadx\nln -sf /opt/jadx/bin/jadx-gui /usr/local/bin/jadx-gui 2>/dev/null || true\n[ -d /opt/jadx ]\n"
 },

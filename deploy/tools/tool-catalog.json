 {
  "id": "netexec",
  "name": "netexec",
  "kind": "script",
  "Script": "set -e\n# NetExec: PyPI withdrawn -> clone source first (retryable, no HTTP2 pip git bug),\n# then install from the local checkout. Explicit symlink as entrypoint fallback.\nrm -rf /opt/netexec-src\nfor i in 1 2 3; do\n  git -c http.version=HTTP/1.1 clone --depth 1 https://github.com/Pennyw0rth/NetExec.git /opt/netexec-src && break\n  rm -rf /opt/netexec-src; sleep 3\ndone\n[ -d /opt/netexec-src ] || { echo \"netexec clone failed\"; exit 1; }\npython3 -m pip install --break-system-packages --no-cache-dir /opt/netexec-src\ncommand -v netexec >/dev/null 2>&1 || { [ -f /usr/local/bin/nxc ] && ln -sf /usr/local/bin/nxc /usr/local/bin/netexec; }\ncommand -v netexec\n"
 },
